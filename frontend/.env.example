# Leave empty when using the Vite proxy. Set this only when the gateway is on another origin.
VITE_API_BASE_URL=

# Vite's server-side proxy target. The normal FinPay Gateway runs on port 8080.
VITE_GATEWAY_PROXY_TARGET=http://localhost:8080

# Set to true for the browser-local showcase build used by GitHub Pages.
VITE_DEMO_MODE=false
VITE_BASE_PATH=/
